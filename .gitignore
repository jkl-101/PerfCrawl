# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# uv / virtualenv
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local SQLite run store (will hold real run data in Phase 2+; never commit)
*.db
*.sqlite
*.sqlite3

# perfcrawl runtime artifacts — per-developer; never committed
# (RESEARCH § Security Domain "Sensitive URL leakage in committed output/")
output/

# Credential-equivalent secrets (Phase 4 / D-07 / AUTH-04) — NEVER committed.
# `.env` carries PERFCRAWL_USERNAME / PERFCRAWL_PASSWORD; a captured Playwright
# `storage_state` (`perfcrawl login --out ...`) is a FULL logged-in session —
# possessing the file is equivalent to possessing the credentials. Both are
# per-developer local secrets; committing either would leak the live session.
.env
.env.*
*.authstate.json
.perfcrawl/

# Google Sheets service-account JSON key (Phase 6 / OUT-02 / D-12) — NEVER
# committed. PERFCRAWL_SHEETS_SA holds only the PATH to this file; the key file
# itself is credential-equivalent. Ignore the conventional naming patterns so a
# stray key dropped beside the repo is never staged.
*.sa.json
*service-account*.json

# OS cruft — never tracked
.DS_Store
.DS_Store?
._*
Thumbs.db

# GSD planning state — per-machine AI-orchestration state, never shared via git
.planning/

# Agent / editor instruction files — local, not tracked
CLAUDE.md
.claude/
